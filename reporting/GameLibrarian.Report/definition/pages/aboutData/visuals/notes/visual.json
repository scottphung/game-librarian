{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "notes",
  "position": {
    "x": 16,
    "y": 84,
    "z": 2000,
    "height": 624,
    "width": 760,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this report is",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "An analytical companion to the Game Librarian website. It summarizes the catalog (the hand-picked games in curated/games.csv and the reviewed candidates in curated/promoted_games.csv; see Catalog Source) and its verified award results. It is not a ranking of all Steam games.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Player reception",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Review counts are Steam's review summary for each game: Steam purchasers, all languages. Review-weighted positive rate pools every review, so games with many reviews dominate. Average game positive rate gives every game the same weight.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Four-year ranking",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only games released in the four years up to the export day are ranked (Ranking window, at the right); the window moves forward each time export-report runs. Ranking Tier is the award group of a game's highest-priority verified result: 1 The Game Awards Game of the Year win, 2 BAFTA Best Game win, 3 D.I.C.E. Game of the Year win, 4 Game Developers Choice Game of the Year win, 5 The Steam Awards Game of the Year win, 6 another win, 7 nominations only, 8 no award recorded. Within a group, more Awards Won rank higher, then more Award Nominations (each result counted once); then Steam reception (500+ reviews first, highest Positive Share first, then more reviews), then the title and the app ID.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Production labels play no part. A game with an award keeps its place without usable review data; one with neither is Unranked. This is Game Librarian's editorial discovery order, not a quality score, and award coverage is incomplete: \"No award recorded\" does not mean the game never received one. The website ranks the same way, with the window ending today.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Awards and labels",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only verified rows are included: The Game Awards (Game of the Year and the independent-game category, 2014–2025), BAFTA Games Awards (Best Game, 2019–2026), Game Developers Choice Awards (Game of the Year, 2019–2026) and The Steam Awards (Game of the Year, Labor of Love and Better With Friends, 2018–2025). Year is the ceremony year, not the release year; use Award (organization and category) to tell the Game of the Year categories apart. AAA / AA / Indie labels need game-specific evidence; \"No verified label\" means none has been verified yet. Both depend on the project's hand-curated data, so labels, award groups and award coverage are only as complete as that data.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Refreshing",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Run python -m game_librarian sync, then python -m game_librarian export-report, then select Refresh in Power BI Desktop. A copy published to the Power BI service changes only when it is refreshed or republished there; running the sync does not update it.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Not included",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prices, player counts and trends over time: the project stores only the latest values, so no history exists to chart.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#C3C2B7"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
