model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","Games","GameTags","Tags","Awards","Export Info"]

ref table Games
ref table GameTags
ref table Tags
ref table Awards
ref table 'Export Info'

