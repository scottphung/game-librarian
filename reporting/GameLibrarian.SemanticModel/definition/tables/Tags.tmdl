/// Steam community tags, including genre tags such as RPG or Roguelike. Use Tag in slicers to filter games.
table Tags
	lineageTag: df19b358-38df-4e02-988a-9fbcbf88b43f

	column Tag
		dataType: string
		lineageTag: ec43d20a-adc4-44c2-89e6-b5f7081139f0
		summarizeBy: none
		sourceColumn: tag

	/// Catalog games that have this tag (at export time, ignoring report filters).
	column 'Games With Tag'
		dataType: int64
		formatString: #,0
		lineageTag: cf06ac04-a1d2-4f54-8206-1105e8d5991b
		summarizeBy: none
		sourceColumn: games

	partition Tags = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "tags.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tag", type text}, {"games", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

